// =============================================================================
//  SilkCrowd - hair.mesh
//  Strand-level parallelism (Section 3.2): one mesh-shader invocation per strand.
//
//  Each invocation generates ONE hair strand from the five textures and emits it as a
//  camera-facing ribbon with exactly 2*ns + 2 vertices and 2*ns triangles
//  (ns = 2^e, the vertex-LOD segment count).
//
//  Vertex-level parallelism: a workgroup of 32 invocations handles 32 strands, so the
//  lanes of a warp/wavefront each own one strand and every texture fetch lane in the
//  wavefront addresses neighbouring bundle space -- the access pattern the texture units
//  want. Vertices inside a strand are generated by the owning invocation (Section 3.2:
//  "each mesh shader thread computes n vertices").
//
//  Mesh-shader output is a triangle list (Vulkan has no strip output), so the ribbon is
//  emitted as 2*ns + 2 shared vertices and 2*ns triangles that index them.
// =============================================================================
#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require

#include "hair_common.glsl"

layout(local_size_x = 32) in;
layout(triangles, max_vertices = 128, max_primitives = 128) out;

layout(location = 0) out vec3 outTangent[];
layout(location = 1) out float outW[];
layout(location = 2) flat out uint outSeed[];
layout(location = 3) out vec3 outWorldPos[];

layout(push_constant) uniform PushConstants {
    uint chunksPerBundle;
    uint tasksPerChunk;
    uint frameIndex;
    uint flags;        // bit 0: shadow pass (use lightModelViewProj)
} pc;

taskPayloadSharedEXT TaskPayload {
    uint bundle;
    uint strandBase;
    uint numStrands;
    uint vertexExponent;
    float gamma;            // Eq. 12, shared by all strands of the bundle
    float thicknessScale;   // strand-LOD thickness compensation, min(1/L, N)
} payload;

// Section 3.3 root sample tables (progressive blue noise, uploaded once).
layout(std430, set = 3, binding = 0) readonly buffer RootSamples {
    vec2 samples[];
} roots;
layout(std430, set = 3, binding = 1) readonly buffer RootSamplesTriangle {
    vec2 samples[];
} rootsTri;
// Per-bundle metadata: .x = isTriangle, .y = authored strand count, .z = seed, .w = unused
layout(std430, set = 2, binding = 1) readonly buffer BundleMeta {
    vec4 meta[];
} bundleMeta;

#define SC_MAX_VERTICES 34

void main() {
    uint localStrand = gl_LocalInvocationID.x;
    uint ns = 1u << clamp(payload.vertexExponent, 0u, 5u);
    uint vertexCount = ns + 1u;

    if (localStrand >= payload.numStrands || vertexCount > SC_MAX_VERTICES) {
        SetMeshOutputsEXT(0u, 0u);
        return;
    }

    uint bundle = payload.bundle;
    uint strandIndex = payload.strandBase + localStrand;

    // ------------------------------------------------------------ root placement
    bool isTriangle = bundleMeta.meta[bundle].x > 0.5;
    uint tableSize = isTriangle ? uint(rootsTri.samples.length()) : uint(roots.samples.length());
    uint sampleIndex = (strandIndex + bundle * 131u) % max(tableSize, 1u);
    vec2 xi = isTriangle ? rootsTri.samples[sampleIndex] : roots.samples[sampleIndex];
    // Section 3.3: quad samples map directly, triangle samples use the mapping that
    // reproduces barycentric interpolation (no bias towards the duplicated vertex).
    vec2 blockCoord = isTriangle ? triangleRootPosition(xi) : clamp(xi, vec2(0.002), vec2(0.998));

    vec2 st = blockToSlice(bundle, blockCoord);
    vec2 uv = sampleUV(st);

    // ------------------------------------------------------------ styling + LOD state
    StrandState state = makeStrandState(uv, strandIndex, bundle);
    float lengthScale = 1.0 - model.styling2.z * 0.5 * scHash11(float(state.seed) * 1e-4);
    float gamma = clamp(payload.gamma, 0.0, 1.0);
    float layers = model.textureSize.w;

    // ------------------------------------------------------------ generate the curve
    vec3 pos[SC_MAX_VERTICES];
    vec3 morphed[SC_MAX_VERTICES];
    float wCoord[SC_MAX_VERTICES];

    // "One exception is the root vertex of the strand, which only requires a single
    // lookup of the hair mesh texture on the root slice" (Section 3.2).
    pos[0] = sampleSlice(st, 0.0);
    morphed[0] = pos[0];
    wCoord[0] = 0.0;

    for (uint k = 1u; k < vertexCount; ++k) {
        float v = float(k) / float(ns);
        float t = v * (layers - 1.0) * lengthScale;
        vec3 base = evalCurve(st, t);                 // 2 trilinear fetches + 1 lerp
        float w = sampleW(st, t);                     // single lookup (no intermediates)
        mat3 Mp = stylingMatrix(st, t);               // u_hat, v_hat, w_hat
        vec2 disp = styleDisplacement(state, w, int(k));
        pos[k] = base + Mp * vec3(disp, 0.0);
        morphed[k] = pos[k];
        wCoord[k] = v;
    }

    // Eq. 11: p'_k = (1-gamma) p_k + gamma (p_(k-1) + p_(k+1))/2, odd k only.
    if (gamma > 0.0) {
        for (uint k = 1u; k + 1u < vertexCount; k += 2u) {
            vec3 avg = (pos[k - 1u] + pos[k + 1u]) * 0.5;
            morphed[k] = mix(pos[k], avg, gamma);
        }
    }

    // ------------------------------------------------------------ tangents (Section 3.5)
    vec3 tangent[SC_MAX_VERTICES];
    for (uint k = 1u; k + 1u < vertexCount; ++k) tangent[k] = pos[k + 1u] - pos[k - 1u];
    tangent[0] = tangentFirst(pos[0], pos[1], tangent[1]);
    tangent[vertexCount - 1u] = tangentLast(pos[vertexCount - 1u], pos[vertexCount - 2u],
                                            tangent[vertexCount - 2u]);

    // t~ from the even-index vertices only, then t' = (1-gamma) t + gamma t~ (Section 3.6.2).
    if (gamma > 0.0) {
        vec3 coarse[SC_MAX_VERTICES];
        for (uint k = 0u; k < vertexCount; k += 2u) {
            uint kp = k >= 2u ? k - 2u : 0u;
            uint kn = min(k + 2u, vertexCount - 1u);
            coarse[k] = normalize(pos[kn] - pos[kp] + vec3(1e-9));
        }
        for (uint k = 1u; k < vertexCount; k += 2u)
            coarse[k] = normalize(coarse[k - 1u] + coarse[k + 1u] + vec3(1e-9));
        for (uint k = 0u; k < vertexCount; ++k)
            tangent[k] = normalize(mix(normalize(tangent[k] + vec3(1e-9)), coarse[k], gamma));
    } else {
        for (uint k = 0u; k < vertexCount; ++k) tangent[k] = normalize(tangent[k] + vec3(1e-9));
    }

    // ------------------------------------------------------------ emit the ribbon
    uint vertexTotal = 2u * ns + 2u;
    uint triangleTotal = 2u * ns;
    SetMeshOutputsEXT(vertexTotal, triangleTotal);

    vec3 cameraObj = (model.modelInv * vec4(model.cameraPos.xyz, 1.0)).xyz;
    float radius = model.styling3.y * state.thicknessScale * payload.thicknessScale;

    for (uint k = 0u; k < vertexCount; ++k) {
        vec3 toCam = normalize(cameraObj - morphed[k]);
        vec3 side = cross(tangent[k], toCam);
        if (dot(side, side) < 1e-12) side = cross(tangent[k], vec3(0.0, 1.0, 0.0));
        side = normalize(side + vec3(1e-9));
        vec3 offset = side * radius;

        mat4 mvp = (pc.flags & 1u) != 0u ? model.lightModelViewProj : model.modelViewProj;
        uint i0 = 2u * k;
        gl_MeshVerticesEXT[i0].gl_Position = mvp * vec4(morphed[k] + offset, 1.0);
        gl_MeshVerticesEXT[i0 + 1u].gl_Position = mvp * vec4(morphed[k] - offset, 1.0);
        outTangent[i0] = normalize((model.model * vec4(tangent[k], 0.0)).xyz);
        outTangent[i0 + 1u] = outTangent[i0];
        outW[i0] = wCoord[k];
        outW[i0 + 1u] = wCoord[k];
        outSeed[i0] = state.seed;
        outSeed[i0 + 1u] = state.seed;
        outWorldPos[i0] = (model.model * vec4(morphed[k], 1.0)).xyz;
        outWorldPos[i0 + 1u] = outWorldPos[i0];
    }

    for (uint k = 0u; k < ns; ++k) {
        uint l0 = 2u * k, r0 = l0 + 1u, l1 = l0 + 2u, r1 = l0 + 3u;
        gl_PrimitiveTriangleIndicesEXT[2u * k] = uvec3(l0, r0, l1);
        gl_PrimitiveTriangleIndicesEXT[2u * k + 1u] = uvec3(l0, l1, r1);
    }
}
