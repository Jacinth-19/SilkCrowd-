// =============================================================================
//  SilkCrowd - hair.frag
//  Marschner BCSDF: longitudinal M (Gaussian per lobe, cuticle-tilt shifted), azimuthal
//  N (von Mises, R and refracted TRT), Fresnel (Schlick, F0 = 0.046), a Kajiya-Kay
//  diffuse term, a dual-scattering approximation for the low-LOD thick strands, IBL and
//  PCF shadows. theta_i/theta_o are the true inclinations, not a half-vector proxy.
// =============================================================================
#version 460

layout(location = 0) in vec3 inTangent;
layout(location = 1) in float inW;
layout(location = 2) flat in uint inSeed;
layout(location = 3) in vec3 inWorldPos;

layout(location = 0) out vec4 outColor;

layout(set = 0, binding = 0) uniform CameraUbo {
    mat4 view;
    mat4 proj;
    vec4 cameraPos;
    vec4 sunDirection;    // xyz direction towards the sun, w = intensity
    vec4 sunColor;
    vec4 skyZenith;
    vec4 skyHorizon;
    vec4 lodScreen;       // viewport height, tan(fov), near, far
} cam;

layout(set = 0, binding = 1) uniform sampler2D shadowMap;
layout(set = 0, binding = 2) uniform LightUbo {
    mat4 lightViewProj;
    vec4 shadowParams;    // x = 1/resolution, y = bias, z = PCF radius, w = enabled
    vec4 hairParams;      // rgb = base colour, w = melanin
} light;

// Hair shading parameters (Marschner 2003 / Kajiya-Kay fallback).
layout(push_constant) uniform HairShading {
    vec4 color;          // base albedo
    vec4 params;         // x = melanin, y = redness, z = dual scatter strength, w = flags
    vec4 params2;        // x = alpha (coverage), y = shadow strength, z = ao, w = roughness
} hs;

const float PI = 3.14159265359;

// Marschner's longitudinal M term (Marschner et al. 2003, Eq. 3): a normalised
// Gaussian in the difference of the incident/outgoing inclinations, shifted by the
// per-lobe tilt alpha (the cuticle scale tilt). thetaI and thetaO are measured from
// the plane normal to the fibre, so a mirror reflection has thetaO = -thetaI and the
// lobe therefore peaks where thetaO + thetaI == alpha.
float longitudinalM(float thetaI, float thetaO, float alpha, float beta) {
    float d = thetaO + thetaI - alpha;
    return exp(-d * d / (2.0 * beta * beta)) / (sqrt(2.0 * PI) * beta);
}

// Fresnel for the two lobes (Schlick with the hair's dielectric F0 = 0.046).
float fresnel(float cosTheta) {
    const float f0 = 0.046;
    return f0 + (1.0 - f0) * pow(1.0 - clamp(cosTheta, 0.0, 1.0), 5.0);
}

// Azimuthal scattering: a von Mises-like lobe (Marschner's N term), plus the TRT shift.
float azimuthalN(float phi, float v) {
    return exp(v * (cos(phi) - 1.0)) / (2.0 * PI * (1.0 - exp(-2.0 * v)));
}

// PCF shadow lookup (3x3 taps) using the hair shadow map generated by the same strand
// generation, or by the head geometry for the scalp.
float sampleShadow(vec4 lightSpacePos) {
    if (light.shadowParams.w < 0.5) return 1.0;
    vec3 proj = lightSpacePos.xyz / max(lightSpacePos.w, 1e-6);
    proj.xy = proj.xy * 0.5 + 0.5;
    if (proj.z > 1.0 || proj.z < 0.0) return 1.0;
    if (proj.x < 0.0 || proj.x > 1.0 || proj.y < 0.0 || proj.y > 1.0) return 1.0;
    float bias = light.shadowParams.y;
    float radius = light.shadowParams.z;
    float sum = 0.0;
    const int taps = 1;
    for (int y = -taps; y <= taps; ++y) {
        for (int x = -taps; x <= taps; ++x) {
            vec2 off = vec2(float(x), float(y)) * radius * light.shadowParams.x;
            float d = texture(shadowMap, proj.xy + off).r;
            sum += (proj.z - bias) > d ? 0.0 : 1.0;
        }
    }
    return sum / 9.0;
}

void main() {
    vec3 T = normalize(inTangent);
    if (dot(T, T) < 1e-8) T = vec3(0.0, 1.0, 0.0);
    vec3 V = normalize(cam.cameraPos.xyz - inWorldPos);
    vec3 L = normalize(cam.sunDirection.xyz);
    vec3 H = normalize(L + V);

    // Root-to-tip darkening (roots are shadowed by the hair above them).
    vec3 rootTint = hs.color.rgb * 0.45;
    vec3 albedo = mix(rootTint, hs.color.rgb, clamp(inW * 1.3 + 0.1, 0.0, 1.0));

    // --- Marschner BCSDF: S = M_p(theta_i, theta_o) * N_p(phi) * Fresnel -------------
    // Inclinations from the fibre's normal plane (sin of the tangent angle is the
    // projected-area cosine, so it doubles as the geometry term below).
    float cosThetaI = sqrt(max(1.0 - dot(T, L) * dot(T, L), 0.0));   // = sin(theta_i)
    float cosThetaO = sqrt(max(1.0 - dot(T, V) * dot(T, V), 0.0));   // = sin(theta_o)
    float thetaI = asin(clamp(dot(T, L), -1.0, 1.0));
    float thetaO = asin(clamp(dot(T, V), -1.0, 1.0));

    // Azimuthal frame: (T, u, v) with u, v spanning the plane normal to the fibre.
    vec3 refUp = abs(T.y) < 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    vec3 azU = normalize(cross(refUp, T));
    vec3 azV = cross(T, azU);
    float phiI = atan(dot(L, azV), dot(L, azU));
    float phiO = atan(dot(V, azV), dot(V, azU));
    // The R lobe mirrors about the normal plane (phi_o = -phi_i, so the sum vanishes on
    // the specular cone); the TRT lobe additionally refracts, which shifts it by delta.
    float phiR = phiO + phiI;
    float phiTRT = phiO + phiI - 0.35;

    // Per-lobe cuticle tilt alpha and roughness beta (degrees -> radians in the constants),
    // and the von-Mises azimuthal width (larger = tighter).
    const float alphaR = -0.10, betaR = 0.10;
    const float alphaTRT = 0.14, betaTRT = 0.20;
    float mR = longitudinalM(thetaI, thetaO, alphaR, betaR);
    float mTRT = longitudinalM(thetaI, thetaO, alphaTRT, betaTRT);
    float nR = azimuthalN(phiR, 180.0);
    float nTRT = azimuthalN(phiTRT, 40.0);

    float f = fresnel(dot(T, H));
    vec3 specColor = mix(vec3(1.0, 0.96, 0.90), albedo * 3.0 + 0.1, hs.params.y);
    vec3 specular = specColor * (mR * nR * f + mTRT * nTRT * (1.0 - f) * 0.5) * cosThetaI;

    // --- Kajiya-Kay diffuse (the fibre wraps light around, so sin(theta_i) not max(cos)) ---
    float sinTL = cosThetaI;
    vec3 diffuse = albedo * sinTL * 0.30;

    // --- dual scattering for low-detail (thick) strands: approximate the multiple
    //     scattering that the removed strands would have contributed (Zinke et al. 2008).
    float dualScatter = hs.params.z;
    vec3 multipleScatter = albedo * albedo * (0.55 * sinTL + 0.25) * dualScatter;

    // --- shadowing / AO ---
    float shadow = sampleShadow(light.lightViewProj * vec4(inWorldPos, 1.0));
    float ao = hs.params2.z * mix(0.55, 1.0, clamp(inW * 1.5, 0.0, 1.0));

    vec3 color = (diffuse + specular) * cam.sunColor.rgb * cam.sunDirection.w * shadow * ao +
                 multipleScatter * cam.sunColor.rgb * ao;

    // --- image-based lighting ---------------------------------------------------------
    // Diffuse: the sky gradient evaluated along the fibre normal (the same two-band
    // approximation the composite pass uses for the sky).
    vec3 N = normalize(cross(T, V));
    vec3 ambient = mix(cam.skyHorizon.rgb * 0.30, cam.skyZenith.rgb * 0.85,
                       clamp(0.5 + 0.5 * dot(N, vec3(0.0, 1.0, 0.0)), 0.0, 1.0));
    color += albedo * ambient * (0.30 + 0.35 * ao);

    // Specular: the R lobe reflects around the half-vector; sampling the analytic sky along
    // that reflection gives the environment highlight that hair gets from a bright sky (the
    // "angel ring" of a real head of hair). The lobe width is the strand roughness.
    vec3 R = reflect(-V, N);
    float skyT = pow(1.0 - clamp(abs(R.y), 0.0, 1.0), 1.7);
    vec3 envSpec = mix(cam.skyZenith.rgb, cam.skyHorizon.rgb, skyT);
    float muSun = clamp(dot(R, L), 0.0, 1.0);
    envSpec += cam.sunColor.rgb * cam.sunDirection.w * (pow(muSun, 64.0) * 0.8 + pow(muSun, 8.0) * 0.08);
    float rough = clamp(hs.params2.w, 0.02, 1.0);
    color += envSpec * fresnel(dot(T, H)) * (1.0 - rough) * ao * 0.55;

    outColor = vec4(color, hs.params2.x);
}
