# Dependency-free build of the core library, validation suite, renderer and tools.
# The full Vulkan 1.3 + Qt6 application is built with CMake (see CMakeLists.txt);
# this Makefile exists so that everything paper-critical can be built and tested with
# nothing but a C++17 compiler.
CXX      ?= g++
CXXFLAGS ?= -std=c++17 -O2 -g -Wall -Wextra -Wno-unused-parameter -Iinclude \
            -Ithird_party/stb -DSILKCROWD_SOURCE_DIR='"$(CURDIR)"' -MMD -MP
# gpu_diag/gpu_probe use dlopen() to answer "is there a Vulkan loader here?" even in a
# build without Vulkan headers; glibc < 2.34 needs -ldl for that.
UNAME_S  := $(shell uname -s)
ifeq ($(UNAME_S),Linux)
LDFLAGS  ?= -ldl
else
LDFLAGS  ?=
endif
BUILD    := build

CORE_SRC := $(wildcard src/core/*.cpp) $(wildcard src/render/*.cpp)
APP_SRC  := src/app/main.cpp src/app/assets_export.cpp src/app/scenes.cpp \
            src/app/gpu_app.cpp src/app/gpu_probe.cpp
TESTS_SRC:= $(wildcard tests/*.cpp)

CORE_OBJ := $(patsubst src/%.cpp,$(BUILD)/%.o,$(CORE_SRC))
APP_OBJ  := $(patsubst src/%.cpp,$(BUILD)/%.o,$(APP_SRC))
TEST_OBJ := $(patsubst tests/%.cpp,$(BUILD)/tests/%.o,$(TESTS_SRC))

.PHONY: all clean validate test bench run gpu-selftest sanitize

all: $(BUILD)/SilkCrowd $(BUILD)/silkcrowd_tests

$(BUILD)/SilkCrowd: $(CORE_OBJ) $(APP_OBJ)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

$(BUILD)/silkcrowd_tests: $(CORE_OBJ) $(TEST_OBJ)
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -o $@ $^ $(LDFLAGS)

# root_placement.cpp generates the blue-noise sets that are baked into assets/noise/*.scbn;
# switching off FMA contraction keeps those files identical across compilers (see CMakeLists.txt).
$(BUILD)/core/root_placement.o: CXXFLAGS += -ffp-contract=off

$(BUILD)/%.o: src/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

$(BUILD)/tests/%.o: tests/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c -o $@ $<

# Header dependencies generated by -MMD (so changing a header rebuilds everything that
# includes it; without this the class layouts can silently disagree between objects).
-include $(CORE_OBJ:.o=.d) $(APP_OBJ:.o=.d) $(TEST_OBJ:.o=.d)

test: $(BUILD)/silkcrowd_tests
	./$(BUILD)/silkcrowd_tests

# AddressSanitizer + UndefinedBehaviorSanitizer over the core library and the tests. One
# translation unit command instead of per-object rules so that `make sanitize` never reuses an
# unsanitised object file. -ffp-contract=off keeps the blue-noise generator matching the baked
# assets in assets/noise/, which --validate checks.
SANFLAGS ?= -std=c++17 -O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer \
            -Wall -Wextra -Wno-unused-parameter -Iinclude -Ithird_party/stb \
            -DSILKCROWD_SOURCE_DIR='"$(CURDIR)"' -ffp-contract=off
sanitize:
	@mkdir -p $(BUILD)/san
	$(CXX) $(SANFLAGS) -o $(BUILD)/san/silkcrowd_tests $(CORE_SRC) $(TESTS_SRC) $(LDFLAGS)
	./$(BUILD)/san/silkcrowd_tests

validate: $(BUILD)/SilkCrowd
	./$(BUILD)/SilkCrowd --validate --report docs/validation_report.txt

bench: $(BUILD)/SilkCrowd
	./$(BUILD)/SilkCrowd --bench --scene crowd --width 960 --height 540 --ssaa 1

run: $(BUILD)/SilkCrowd
	./$(BUILD)/SilkCrowd --screenshot renders/head.png --scene head

# Exercises the --gpu-info code against a synthetic loader; skips when Vulkan headers are
# absent, so it is safe to run anywhere.
gpu-selftest:
	./tools/gpu_probe_selftest.sh

clean:
	rm -rf $(BUILD)
