<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vulkan 1.1 is required (the mesh-shader path is used when VK_EXT_mesh_shader is
         present, otherwise the compute fallback of Section 3.2 runs). -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />

    <application
        android:label="SilkCrowd"
        android:hasCode="false"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:screenOrientation="landscape">
            <meta-data android:name="android.app.lib_name" android:value="silkcrowd" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
